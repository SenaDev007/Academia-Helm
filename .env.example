# ============================================================================
# Academia Helm — Backend .env TEMPLATE (à copier vers .env et remplir)
# ============================================================================
# ⚠️ NE JAMAIS COMMITTER le fichier .env réel — il contient des secrets.
# Ce fichier .env.example est commité comme template.
# ============================================================================

# ─── Base de données ──────────────────────────────────────────────────────
DATABASE_URL=file:./dev.db

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret

# ─── Firebase Cloud Messaging (V3-4) ───────────────────────────────────────
# Option A : fichier JSON de service account (recommandé)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B : variables individuelles
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_CLIENT_ID=
# FIREBASE_CLIENT_X509_CERT_URL=

# ─── ORION AI (V3-3) ───────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Whisper transcription (V3-2) ──────────────────────────────────────────
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=fr

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@academiahelm.com

# ─── Communication ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@academiahelm.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Stockage (R2 / S3) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=academia-helm
R2_PUBLIC_URL=

# ─── Port ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
