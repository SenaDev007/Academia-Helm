# NOTE: .g.dart and .freezed.dart files ARE tracked in the mobile app
# (they are committed alongside their source files). This is intentional
# so that the project builds without requiring `dart run build_runner`
# on every clone. Do NOT add ignore rules for these files.

# Flutter SDK (if installed locally in the project)
