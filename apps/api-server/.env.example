# ⭐ Connection string Neon — IMPORTANT pour la résilience
#
# Utilisez l'endpoint POOLER (suffixe -pooler) pour bénéficier du multiplexing
# de connexions côté Neon. Cela réduit le risque de connexions stale.
#
# N'ajoutez PAS pgbouncer=true dans l'URL — Prisma avec @prisma/adapter-pg
# utilise des connexions directes, pas le mode transaction PgBouncer.
#
# Format recommandé :
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# ⚠️ Si vous utilisez l'endpoint DIRECT (sans -pooler), le free tier Neon
#    limite à 5 connexions simultanées. Le pool est configuré pour 2 connexions
#    en mode direct, 3 en mode pooler — adapté au serverless.
#
# Pour le dev local :
# DATABASE_URL=postgresql://user:password@localhost:5432/academiahelm

# ==========================================
# REDIS CACHE (Upstash) - Cache distribué
# ==========================================
# Si configuré → Redis (partagé entre instances, survit aux redémarrages)
# Si absent → cache en mémoire (local à l'instance)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ==========================================
# REDIS SOCKET.IO ADAPTER — multi-réplicas Helm Connect (DORMANT)
# ==========================================
# Sans REDIS_URL : adapter Socket.io in-memory (mono-instance = nominal,
# zéro connexion Redis). Le jour du multi-réplicas (palier 100 écoles) :
#   - soit le plugin Redis Railway (REDIS_URL injecté automatiquement) ;
#   - soit votre Upstash EXISTANT, mais avec la chaîne DIRECTE
#     « rediss://default:<password>@<host>:6379 » (console Upstash →
#     bouton « Connect » → snippet ioredis) — ⚠️ PAS les variables REST
#     ci-dessus : l'API REST Upstash ne supporte pas le pub/sub (SUBSCRIBE),
#     seul le protocole Redis direct (ioredis) peut alimenter l'adapter.
#REDIS_URL=rediss://default:your-password@your-db.upstash.io:6379
# Kill switch : désactive l'adapter même si REDIS_URL est défini
#USE_REDIS_ADAPTER=true
# Mode strict (multi-réplicas) : crash au boot si Redis indisponible,
# plutôt que servir en mode cross-réplica dégradé silencieux
#REDIS_ADAPTER_STRICT=true
# Timeout de connexion Redis au boot (ms) — bien sous la grace period Railway (300 s)
#REDIS_CONNECT_TIMEOUT_MS=15000

# Seuil de log des requêtes lentes Prisma (ms). 0 = désactivé.
SLOW_QUERY_THRESHOLD=500

JWT_SECRET=your-secret-min-32-chars
JWT_EXPIRES_IN=7d
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://academiahelm.com
APP_PUBLIC_URL=https://academiahelm.com
APP_BASE_DOMAIN=academiahelm.com

# ==========================================
# DOMAIN MANAGEMENT - CLOUDFLARE + VERCEL
# ==========================================
# Permet la création automatique des sous-domaines d'écoles
# lors de l'onboarding (CNAME Cloudflare + Domaine Vercel + SSL)

# Cloudflare API (pour créer les CNAME DNS)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# Vercel API (pour ajouter les domaines au projet et émettre les certificats SSL)
VERCEL_API_TOKEN=your_vercel_api_token
VERCEL_PROJECT_ID=your_vercel_project_id
# VERCEL_TEAM_ID=your_vercel_team_id  # Optionnel — seulement si vous utilisez un team

# ==========================================
# FILE STORAGE CONFIGURATION
# ==========================================
# Options: r2 (recommandé), s3, vercel-blob, local
STORAGE_TYPE=r2

# ─── Cloudflare R2 (recommandé — S3-compatible, sans frais de sortie) ───
# 1. Créer un bucket R2 dans le dashboard Cloudflare (ex: academia-helm-releases)
# 2. Créer un API Token avec permissions R2 (Object Read & Write) — IMPORTANT
# 3. Configurer un Custom Domain (ex: downloads.academiahelm.com)
# 4. Renseigner les variables ci-dessous
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=academia-helm-releases
S3_REGION=auto
S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# URL publique du bucket (via Custom Domain R2 — fortement recommandé pour cache CDN)
S3_PUBLIC_URL=https://downloads.academiahelm.com
#
# ⚡ Lorsque STORAGE_TYPE=r2, l'auto-migration base64 → R2 s'exécute au démarrage
#   (voir src/storage-migration/storage-migration.service.ts). Non-bloquant, idempotent.

# ─── AWS S3 (alternative — nécessite un compte AWS vérifié) ───
# STORAGE_TYPE=s3
# S3_BUCKET=academiahelm-docs
# S3_REGION=eu-west-3
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...

# ─── Vercel Blob (alternative — gratuit, sans vérification de compte) ───
# STORAGE_TYPE=vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ─── AI Configuration (NVIDIA GLM-5.3) ───
# Clé API pour les IA intégrées (Orion, Atlas, Sara, HDIE, SCE)
# ⭐ NVIDIA (recommandé) : https://build.nvidia.com — modèle z-ai/glm-5.3
# Legacy Modal (gratuit) : https://modal.com/glm-5-endpoint
# Legacy OpenRouter (payant) : https://openrouter.ai
NVIDIA_API_KEY=
# ⭐ 2026-10-16 — glm-5.2/minimax-m3/gpt-oss-120b ont été RETIRÉS de l'API
#   hébergée NVIDIA (404). Modèles texte actuels : z-ai/glm-5.3 (raisonnement),
#   z-ai/glm-5.3-flash (rapide), openai/gpt-oss-20b (function calling).
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# ─── Extraction IA des fiches pédagogiques (Espace pédagogique → captures) ───
# Modèles VISION utilisés par /pedagogy-space/fiches/extract-ai (OpenAI-compatible).
# ⭐ 2026-10-16 v3 — chaîne mise à jour (vérifiée sur GET /v1/models) :
#   principal : nemotron-3.5-super-vl (VL MoE 120B-A12B, thinking désactivable) ;
#   repli : deepseek-v4.1-flash (VLM flash, sans raisonnement) ;
#   2ᵉ repli : nemotron-3-nano-omni (OCR multi-images, thinking désactivé).
# meta/llama-3.2-11b-vision-instruct écarté (1 image/requête, réduction 1120px).
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_FALLBACK=deepseek-ai/deepseek-v4.1-flash
NVIDIA_VISION_TERTIARY=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Variables legacy (rétro-compatibilité — ignorées si NVIDIA_* est défini)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=zai-org/GLM-5.1-FP8
# OPENROUTER_BASE_URL=https://api.us-west-2.modal.direct/v1
# Secret webhook : copier exactement la valeur du dashboard FedaPay (sandbox ou live) pour l’URL du webhook
# FEDAPAY_WEBHOOK_SECRET=

# Dév / staging uniquement (jamais en production) — contourne la vérification de signature si le secret ne matche pas
# SKIP_WEBHOOK_SIGNATURE=false
# FEDAPAY_WEBHOOK_SKIP_VERIFY=false

# Liste publique des écoles + dropdown « Mode développement » du portail : tous les tenants si true (tests plateforme en prod)
PLATFORM_OWNER_MODE=false

# ==========================================
# EMAIL CONFIGURATION (Nodemailer / SendGrid / Resend)
# ==========================================
EMAIL_PROVIDER=resend # Options: nodemailer, sendgrid, resend, aws-ses, mock

# RESEND (Recommandé — utilisez Resend pour les emails transactionnels)
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM_NOREPLY=noreply@academiahelm.com

# SMTP (Nodemailer — alternative)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password-or-sendgrid-api-key
SMTP_SECURE=false

# ==========================================
# 📧 TÂCHE 181 — E-MAIL ÉCOLE (Gmail de chaque établissement)
# ==========================================
# Clé maître AES-256-GCM des secrets e-mail des écoles (mots de passe
# d'application SMTP, puis jetons OAuth2 en phase 2). 32 octets, hex (64
# caractères) ou base64. Génération : openssl rand -hex 32
# ⚠️ Ne JAMAIS committer la vraie clé. Si elle change, les écoles passent en
# statut « Expiré » et doivent reconnecter leur compte (mesure CDC §7.6).
# Sans cette variable, une clé dérivée de DATABASE_URL est utilisée (repli
# déterministe — la faire tourner reste possible mais expire les secrets).
EMAIL_ENCRYPTION_KEY=

# ==========================================
# 📧 TÂCHE 183 (PHASE 2) — GOOGLE OAUTH2 (CDC section 8)
# ==========================================
# Client OAuth de la PLATEFORME Academia Helm (un seul client pour toutes
# les écoles — chaque direction autorise ensuite SON compte Gmail).
# Création : Google Cloud Console → API & Services → Identifiants →
# « ID client OAuth » (type Application Web), avec l'URI de redirection :
#   https://api.academiahelm.com/api/school-email/google/callback
# Écran de consentement : portée sensible « gmail.send » — publier l'appli
# (ou la laisser en test avec les comptes Google des écoles de recette).
# Vide = l'option Google OAuth2 reste masquée côté écoles (SMTP seul).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Facultatif — override explicite de l'URI de redirection (sinon dérivée
# de l'origine de la requête : https://api.academiahelm.com/api/school-email/google/callback).
#GOOGLE_OAUTH_REDIRECT_URI=

SMTP_FROM=noreply@academiahelm.com

# SENDGRID (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@academiahelm.com
SENDGRID_FROM_NAME="Academia Helm"

# ════════════════════════════════════════════════════════════════════════
# FEEXPAY — Paiements Mobile Money (Abonnements AH + Frais scolaires + Salaires)
# ════════════════════════════════════════════════════════════════════════
# Documentation : https://docs.feexpay.me
# Dashboard : https://app-v2.feexpay.me
#
# Ces credentials sont pour le compte ACADEMIA HELM (pour collecter les abonnements).
# Chaque école (tenant) configure ses propres credentials FeexPay via
# Paramètres > Paiements (stockés chiffrés en base, jamais en env).
#
# FEEXPAY_API_KEY : Token d'authentification Bearer (depuis le dashboard FeexPay)
# FEEXPAY_SHOP_ID : Identifiant public de la boutique (15 caractères, ex: nGLq7rMBFBVbpuc)
# FEEXPAY_API_URL : Base URL API (v2 par défaut)
FEEXPAY_API_KEY=your-feexpay-api-key
FEEXPAY_SHOP_ID=your-shop-id
FEEXPAY_API_URL=https://api-v2.feexpay.me

# Clé de chiffrement pour les credentials sensibles stockés en base (API keys tenants, etc.)
# Doit faire 64 caractères hexadécimaux (32 bytes). Générez avec : openssl rand -hex 32
# Si non définie, une clé dérivée de JWT_SECRET est utilisée (non recommandé en production)
CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-encryption-key-here-0000000000000000000000000000000000

# ════════════════════════════════════════════════════════════════════════
# WHATSAPP — Notifications WhatsApp Business
# ════════════════════════════════════════════════════════════════════════
# Provider: gupshup | whatsapp-business | twilio-whatsapp | infobip-whatsapp | gateway | mock
# - gupshup : RECOMMANDÉ — templates pré-approuvés Meta via Gupshup.io
# - mock : aucun envoi réel (mode développement)
WHATSAPP_PROVIDER=mock

# --- Gupshup.io (https://portal.gupshup.io) ---
# Dashboard → My Apps → sélectionner l'app WhatsApp → API Key (en haut à droite)
# GUPSHUP_APP_NAME    : nom de l'app WhatsApp créé sur Gupshup
# GUPSHUP_SOURCE_PHONE: numéro WhatsApp Business (format international SANS "+", ex: 229XXXXXXXX pour Bénin)
# GUPSHUP_API_URL     : base URL de l'API Gupshup (défaut: https://api.gupshup.io/wa/api/v1)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_PHONE=
GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1
GUPSHUP_TEMPLATE_LANG=fr

# --- WhatsApp Business API (Facebook Graph) — alternative ---
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=

# --- Gateway générique — alternative ---
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# LIVEKIT — Voice/Video/Stage channels (SFU for >5 participants)
# ════════════════════════════════════════════════════════════════════════
# LiveKit is the SFU (Selective Forwarding Unit) that powers Discord-style
# persistent voice channels, stage channels, and live streaming (Go Live).
#
# Get your keys from the LiveKit Cloud dashboard (https://cloud.livekit.io):
#   - LIVEKIT_URL       : wss://your-project.livekit.cloud
#   - LIVEKIT_API_KEY    : API key (Project Settings → Keys)
#   - LIVEKIT_API_SECRET : API secret (same page)
#
# On Railway: add these as variables in your service settings.
# If not set, voice channels fall back to mesh WebRTC (≤5 participants).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ════════════════════════════════════════════════════════════════════════
# ⭐ V4 — CHAÎNE MÉDIA DES APPELS (Helm Connect, portée de Yeshua Connect)
# ════════════════════════════════════════════════════════════════════════
# Ordre STRICT de repli : LiveKit → Agora → Daily. Un fournisseur sans
# identifiants est simplement SAUTÉ (chaîne dégradée propre). Si AUCUN
# fournisseur n'est configuré, les appels retombent sur le mesh WebRTC
# existant (≤5 participants).
#
# ⭐ LiveKit est la source de vérité — configurez-le EN PREMIER :
#   1-1 audio/vidéo + appels de groupe + canaux vocaux + partage d'écran,
#   via SFU (passe à l'échelle au-delà de 5 participants).
#   Les appels ne fonctionnent « à merveille » qu'avec LiveKit configuré.
#
# AGORA (repli n°1) — https://console.agora.io (Project → App ID + certificate)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# DAILY (repli n°2) — https://dashboard.daily.co (API key)
DAILY_API_KEY=

# ─── Notifications push des appels entrants (best effort, silencieux si vide) ───
# Web Push (navigateurs) — générez les clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@academiahelm.com

# FCM mobile (Firebase Admin — json du compte de service, voir FIREBASE_*)

# ─── Divers chat ───
# GIF Tenor (https://developers.google.com/tenor) — recherche de GIF dans le chat
TENOR_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# ADMIN PLATEFORME — Fallback env pour le mode YEHI OR Tech (onboarding)
# ════════════════════════════════════════════════════════════════════════
# Le back-office admin.academiahelm.com s'authentifie via ces variables
# (configurées côté Vercel/web-app), SANS passer par la table users.
# Si vous les synchronisez AUSSI ici (Railway), les mêmes identifiants
# back-office seront acceptés par le wizard d'onboarding (mode YEHI OR
# Tech) même sans compte SUPER_ADMIN en DB — ou après un changement de
# mot de passe back-office non répliqué en DB.
# Sans ADMIN_PASSWORDS ici, la validation reste DB uniquement (compte
# SUPER_ADMIN actif requis dans la table users).
ADMIN_EMAILS=
# JSON : { "admin@example.com": "$2a$10$..." } (hash bcrypt du mot de passe)
ADMIN_PASSWORDS=

# ════════════════════════════════════════════════════════════════════════
# ⭐ V5 — ANTIVIRUS DES PIÈCES JOINTES HELM CONNECT (optionnel)
# ════════════════════════════════════════════════════════════════════════
# Scan AVANT sauvegarde des uploads de messages (415 « Fichier rejeté
# (malware détecté) » si positif). SANS configuration → scan skipped,
# comportement par défaut inchangé (fichiers acceptés).
#
# 1) VirusTotal (cloud — https://www.virustotal.com/gui/my-apikey) :
#    GET du rapport par SHA-256 d'abord (zéro upload si hash connu), puis
#    upload multipart si inconnu. Refus si stats.malicious > 0.
VIRUSTOTAL_API_KEY=
#
# 2) ClamAV (réseau — protocole INSTREAM, chunk 32 Ko, max 25 Mo) :
#    Toute erreur réseau/protocole → skip silencieux (jamais bloquant).
#    Ex : clamav dans un docker-compose (CLAMAV_HOST=clamav, port 3310).
CLAMAV_HOST=
CLAMAV_PORT=3310

# ════════════════════════════════════════════════════════════════════════
# ⭐ V5 — CANAL DE NOTIFICATION DES APPELS ENTRANTS (mobile)
# ════════════════════════════════════════════════════════════════════════
# Les appels entrants Helm Connect sont envoyés en FCM android avec
# channel_id 'helm_calls' (priority high, ttl 45s) et en APNs
# interruption-level 'time-sensitive' (expiration +45s).
# → L'app mobile DOIT créer un canal de notification Android id 'helm_calls'
#   (sonnerie longue/vibration dédiée aux appels) sinon le système utilise
#   le canal par défaut et l'appel entrant peut passer inaperçu.
# (aucune variable d'environnement — le canal est codé côté app mobile)

# ════════════════════════════════════════════════════════════════════════
# ⭐ 15/11/2026 — SMS TERMIi (identifiants comptes parents — 1er canal)
# ════════════════════════════════════════════════════════════════════════
# Provider SMS actif : 'termii' (recommandé — demande promoteur nov. 2026),
# 'twilio', 'infobip', 'gateway', 'mock' (défaut — ne rien envoie vraiment).
# Le canal SMS des identifiants parents n'est actif QUE si un vrai provider
# est configuré (sinon « skipped — non configuré » dans l'UI, jamais de
# faux succès).
SMS_PROVIDER=termii
# Clé API du dashboard Termii (https://developers.termii.com) — REQUISE.
TERMII_API_KEY=
# URL de base de l'API Termii (défaut ci-dessous).
TERMII_BASE_URL=https://v4.api.termii.com
# Sender ID alphanumérique (3-11 caractères) enregistré sur le compte
# Termii — c'est le nom qui s'affiche comme expéditeur du SMS.
TERMII_SENDER_ID=Academia Helm
# Route d'envoi Termii : 'dnd' (défaut — transactionnel, recommandé pour
# les identifiants, délivre même les numéros en DND ; route à activer auprès
# du support Termii) ou 'generic' (promotionnel — échoue sur les numéros en
# DND). Les numéros sont au format international actuel du Bénin
# (+22901XXXXXXXX, réforme ARCEP du 30/11/2024).
TERMII_CHANNEL=dnd
