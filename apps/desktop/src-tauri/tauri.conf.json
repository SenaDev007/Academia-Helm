{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Academia Helm",
  "version": "1.0.0",
  "identifier": "com.yehiortech.academiahelm.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:3001/desktop",
    "beforeDevCommand": "cd ../web-app && npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Academia Helm",
        "url": "splash.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.fedapay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-src 'self' https://cdn.fedapay.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "publisher": "YEHI OR Tech",
    "copyright": "© 2026 YEHI OR Tech. Tous droits réservés.",
    "category": "Education",
    "shortDescription": "Plateforme de gestion scolaire Academia Helm",
    "longDescription": "Academia Helm — la plateforme de gestion scolaire tout-en-un pour les établissements africains. Développé par YEHI OR Tech.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.academiahelm.com/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "PUBKEY_PLACEHOLDER_REPLACE_WITH_GENERATED_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
