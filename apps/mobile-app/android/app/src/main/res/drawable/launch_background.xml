<?xml version="1.0" encoding="utf-8"?>
<!-- Launch background for the splash screen.
     IMPORTANT: the <bitmap> src attribute MUST point to a PNG resource,
     NOT to an adaptive-icon XML (mipmap-anydpi-v26/ic_launcher.xml).
     Using @mipmap/ic_launcher here crashes on Android 8+ because adaptive
     icons cannot be inflated as a BitmapDrawable. Use the foreground PNG
     directly instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ah_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
