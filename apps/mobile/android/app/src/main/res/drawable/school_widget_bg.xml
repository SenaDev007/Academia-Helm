<?xml version="1.0" encoding="utf-8"?>
<!-- Fond arrondi du widget. La couleur est teintée au runtime avec la
     couleur principale de l'école (RemoteViews.setColorStateList →
     setBackgroundTintList, API 26+) ; le navy reste la valeur par défaut
     affichée avant toute teinte. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="#0B2F73" />
</shape>
