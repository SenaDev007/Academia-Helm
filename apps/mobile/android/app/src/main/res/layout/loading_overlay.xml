<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════
     ÉCRAN DE CHARGEMENT NATIF (anti « page blanche »)

     Posé AU-DESSUS du WebView par MainActivity dès le premier frame :
     il couvre le démarrage à froid ET chaque navigation complète du
     WebView, puis se retire dès que la page distante (Vercel) est peinte.
     Mêmes visuels que la splash (logo sur navy #0B2F73) → transition
     invisible. Les icônes système (réseau/batterie/heure) restent
     visibles : dessinées par SystemUI au-dessus des fenêtres de l'app.
     ════════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <!-- Logo Academia Helm (même drawable que la splash, couvre tout le fond). -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash"
        android:importantForAccessibility="no" />

    <!-- Indicateur de chargement — doré officiel #F5B335 (colorAccent). -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:indeterminateTint="@color/colorAccent" />
</FrameLayout>
