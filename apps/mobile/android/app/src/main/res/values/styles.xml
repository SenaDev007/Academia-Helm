<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Fond de fenêtre navy (cohérence si ce thème de secours sert un jour). -->
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ⭐ Thème RUNTIME de l'activité (BridgeActivity.setTheme au onCreate) :
         adjustMarginsForEdgeToEdge='force' pose les marges SUR le WebView →
         les zones des barres système (statut en haut / navigation en bas)
         laissent apparaître le windowBackground. Sans définition = BLANC par
         défaut en mode jour → les icônes système blanches (réseau/batterie/
         heure) devenaient INVISIBLES. NB : Android 15 (API 35) ignore
         statusBarColor en edge-to-edge — le fond de fenêtre est la méthode
         fiable, en jour comme en nuit. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <!-- Icônes système claires (blanches) sur fond navy — explicite pour
             neutraliser toute variation DayNight (jour/nuit). -->
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>