# ============================================================================
# Helm Connect — Android .gitignore
# ============================================================================

# Local configuration (machine-specific paths to Flutter SDK + JDK)
local.properties

# Gradle
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# Build outputs
build/
captures/
app/build/
app/.cxx/

# Android Studio / IntelliJ
*.iml
.idea/
.cxx/

# Keystore (NEVER commit)
*.keystore
*.jks
key.properties

# Google Services (Firebase) config — keep template, ignore real file
google-services.json

# Generated files
*.apk
*.aab
*.ap_
*.dex
