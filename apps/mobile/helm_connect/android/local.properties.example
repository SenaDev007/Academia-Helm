# ============================================================================
# Helm Connect — local.properties TEMPLATE
# ============================================================================
# Copy this file to `local.properties` (in the same directory) and replace
# the values with your actual machine paths.
#
# This file is NOT committed to git — it's machine-specific.
# ============================================================================

# Path to the Flutter SDK (run `flutter doctor` to find this path on your machine)
sdk.dir=/Users/YOUR_USERNAME/development/flutter

# Path to the Android SDK (set by Android Studio on first project open)
# Usually auto-configured — leave the line below commented out unless you have a custom path
# flutter.sdk=/Users/YOUR_USERNAME/Library/Android/sdk

# Default Flutter version metadata (auto-set by `flutter build`)
flutter.versionCode=1
flutter.versionName=1.0.0
